<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Night theme: inherit the shared MobileTinaLegacyBase and only override night-specific items -->
    <style name="MobileTinaLegacyTheme" parent="MobileTinaLegacyBase">
        <item name="fontFamily">@font/text</item>
        <item name="android:fontFamily">@font/text</item>
        <!-- OLED surfaces stay black at every elevation. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="elevationOverlayEnabled">false</item>
        <!-- Night mode specific overrides -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>