<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:layoutDirection="ltr">
    <TextView android:id="@+id/notification_profile" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2"
        android:ellipsize="end" android:textSize="12sp" android:layout_marginEnd="8dp"
        android:gravity="start|center_vertical" android:textAlignment="viewStart"
        android:textDirection="firstStrong"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    <FrameLayout android:id="@+id/notification_stop" android:layout_width="148dp"
        android:layout_height="48dp" android:layout_gravity="center_vertical"
        android:contentDescription="@string/notification_action_stop_v2ray"
        android:clickable="true" android:focusable="true">
        <TextView android:layout_width="140dp" android:layout_height="32dp"
            android:layout_gravity="center" android:gravity="center"
            android:background="@drawable/vpn_notification_stop" android:paddingHorizontal="6dp"
            android:text="@string/notification_action_stop_v2ray" android:textColor="#000000"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="2"
            android:fontFamily="sans-serif-medium" android:textDirection="rtl"
            android:textAlignment="center"
            android:includeFontPadding="false" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
