<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingVertical="4dp">
    <TextView android:id="@+id/notification_profile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    <TextView android:id="@+id/notification_traffic" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="3" android:paddingVertical="4dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
    <TextView android:id="@+id/notification_stop" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center" android:layout_marginTop="4dp"
        android:background="@drawable/vpn_notification_stop" android:paddingHorizontal="8dp"
        android:text="@string/notification_action_stop_v2ray" android:textColor="#FFFFFF"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="2"
        android:clickable="true" android:focusable="true" />
</LinearLayout>
