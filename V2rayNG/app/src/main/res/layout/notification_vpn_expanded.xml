<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingVertical="4dp">
    <TextView android:id="@+id/notification_profile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    <TextView android:id="@+id/notification_traffic" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="3" android:paddingVertical="4dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
    <FrameLayout android:id="@+id/notification_stop" android:layout_width="148dp"
        android:layout_height="48dp" android:layout_gravity="end" android:layout_marginTop="4dp"
        android:contentDescription="@string/notification_action_stop_v2ray"
        android:clickable="true" android:focusable="true">
        <TextView android:layout_width="140dp" android:layout_height="32dp"
            android:layout_gravity="center" android:gravity="center"
            android:background="@drawable/vpn_notification_stop" android:paddingHorizontal="6dp"
            android:text="@string/notification_action_stop_v2ray" android:textColor="#000000"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="2"
            android:includeFontPadding="false" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
