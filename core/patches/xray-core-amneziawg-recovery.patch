@@ -0,0 +1,77 @@
+package wireguard
+
+import (
+	"context"
+	"time"
+	"encoding/hex"
+	"strconv"
+	"sync"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+)
+
+// Only live Amnezia devices participate; standard WireGuard is untouched.
+var amneziaHandlers sync.Map
+
+// RefreshAmneziaBindings reconnects protected UDP sockets after Android sleep or
+// a default-network change. The TUN, routing and existing core instance survive.
+func RefreshAmneziaBindings() error {
+	var firstError error
+	amneziaHandlers.Range(func(key, _ any) bool {
+		if err := key.(*Handler).refreshAmneziaBinding(); err != nil && firstError == nil {
+			firstError = err
+		}
+		return true
+	})
+	return firstError
+}
+
+func (h *Handler) refreshAmneziaBinding() error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.dev == nil || h.conf == nil || h.conf.AmneziaConfig == "" || !h.canup.Load() {
+		return nil
+	}
+	// A previously failed bind can leave the device up with no receive socket.
+	// BindUpdate explicitly reopens it, unlike Up() on an already-up device.
+	if err := h.dev.Up(); err != nil {
+		return err
+	}
+	if err := h.dev.BindUpdate(); err != nil {
+		return err
+	}
+	for _, config := range h.conf.Peers {
+		decoded, err := hex.DecodeString(config.PublicKey)
+		if err != nil || len(decoded) != 32 {
+			continue
+		}
+		var key device.NoisePublicKey
+		copy(key[:], decoded)
+		if peer := h.dev.LookupPeer(key); peer != nil {
+			if err := peer.SendHandshakeInitiation(false); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// Mobile NAT mappings commonly expire before long INI keepalive intervals.
+// Apply the mobile policy at runtime, also covering custom JSON and old imports.
+// Explicit zero remains an opt-out and stored/exported profiles are not rewritten.
+func mobileAmneziaKeepalive(amnezia bool, configured string) string {
+	if !amnezia || configured == "0" {
+		return configured
+	}
+	seconds, err := strconv.Atoi(configured)
+	if configured == "" || (err == nil && seconds > 25) {
+		return "25"
+	}
+	return configured
+}
+
+// Preserve routing/protection values while detaching a long-lived AWG socket
+// from the first request's cancellation. Each socket reopen is still bounded.
+func mobileAmneziaDialContext(ctx context.Context) (context.Context, context.CancelFunc) {
+    return context.WithTimeout(context.WithoutCancel(ctx), 15*time.Second)
+}
