+package wireguard
+
+import (
+ "testing"
+ "context"
+ "time"
+)
+
+func TestMobileAmneziaKeepalive(t *testing.T) {
+	for _, tt := range []struct {
+		awg         bool
+		input, want string
+	}{
+		{true, "", "25"}, {true, "1500", "25"}, {true, "60", "25"},
+		{true, "25", "25"}, {true, "10", "10"}, {true, "0", "0"},
+		{false, "", ""}, {false, "1500", "1500"}, {false, "0", "0"},
+		{true, "invalid", "invalid"},
+	} {
+		if got := mobileAmneziaKeepalive(tt.awg, tt.input); got != tt.want {
+			t.Errorf("awg=%v interval=%q: got %q want %q", tt.awg, tt.input, got, tt.want)
+		}
+	}
+}
+
+func TestRefreshClosedAmneziaHandler(t *testing.T) {
+	h := &Handler{}
+	amneziaHandlers.Store(h, struct{}{})
+	defer amneziaHandlers.Delete(h)
+	if err := RefreshAmneziaBindings(); err != nil {
+		t.Fatal(err)
+	}
+	if h.dev != nil {
+		t.Fatal("refresh resurrected a closed device")
+	}
+}
+
+func TestAmneziaCloseUnregistersHandler(t *testing.T) {
+    h := &Handler{}
+    amneziaHandlers.Store(h, struct{}{})
+    defer amneziaHandlers.Delete(h)
+    if err := h.Close(); err != nil { t.Fatal(err) }
+    if _, present := amneziaHandlers.Load(h); present { t.Fatal("closed handler remains registered") }
+    if err := RefreshAmneziaBindings(); err != nil { t.Fatal(err) }
+}
+
+func TestAmneziaDialDetachesRequestCancellation(t *testing.T) {
+    type contextKey struct{}
+    parent, cancelParent := context.WithCancel(context.WithValue(context.Background(), contextKey{}, "protected"))
+    cancelParent()
+    ctx, cancel := mobileAmneziaDialContext(parent)
+    defer cancel()
+    if ctx.Err() != nil { t.Fatalf("request cancellation killed AWG dial: %v", ctx.Err()) }
+    if ctx.Value(contextKey{}) != "protected" { t.Fatal("routing/protection context was lost") }
+    deadline, ok := ctx.Deadline()
+    if !ok || time.Until(deadline) <= 0 || time.Until(deadline) > 15*time.Second { t.Fatal("AWG dial must have a 15-second bound") }
+    cancel()
+    if ctx.Err() != context.Canceled { t.Fatal("explicit cleanup did not cancel AWG dial") }
+}
