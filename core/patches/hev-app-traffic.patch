+static jstring
+native_get_source (JNIEnv *env, jobject thiz, jint protocol, jint port)
+{
+    char address[46], result[64];
+    int original_port;
+    if (!hev_app_traffic_resolve (protocol, port, address, sizeof (address), &original_port))
+        return NULL;
+    snprintf (result, sizeof (result), "%s\n%d", address, original_port);
+    return (*env)->NewStringUTF (env, result);
+}
+
