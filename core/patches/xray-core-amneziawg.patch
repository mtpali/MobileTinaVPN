diff --git a/infra/conf/wireguard_amnezia_test.go b/infra/conf/wireguard_amnezia_test.go
new file mode 100644
index 0000000..35064be
--- /dev/null
+++ b/infra/conf/wireguard_amnezia_test.go
@@ -0,0 +1,57 @@
+package conf
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAmneziaWGConfigBuildIPC(t *testing.T) {
+	config := &AmneziaWGConfig{
+		Jc:                      5,
+		Jmin:                    20,
+		Jmax:                    40,
+		S1:                      64,
+		S2:                      80,
+		S3:                      96,
+		S4:                      112,
+		H1:                      "100-110",
+		I1:                      "<b 0x0102><r 8>",
+		ContentPaddingAddition:  "4-12",
+		RekeyAfterTime:          "90-120",
+		RandomizePacketTrailers: true,
+		DisableCookieReplies:    true,
+	}
+
+	ipc, err := config.BuildIPC()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, expected := range []string{
+		"jc=5\n",
+		"jmin=20\n",
+		"jmax=40\n",
+		"s4=112\n",
+		"h1=100-110\n",
+		"i1=<b 0x0102><r 8>\n",
+		"content_padding_addition=4-12\n",
+		"rekey_after_time=90-120\n",
+		"random_trailers=true\n",
+		"disable_cookies=true\n",
+	} {
+		if !strings.Contains(ipc, expected) {
+			t.Fatalf("missing %q in %q", expected, ipc)
+		}
+	}
+}
+
+func TestAmneziaWGConfigRejectsInvalidRanges(t *testing.T) {
+	for _, config := range []*AmneziaWGConfig{
+		{Jmin: 40, Jmax: 20},
+		{H1: "40-20"},
+		{S1: 65536},
+	} {
+		if _, err := config.BuildIPC(); err == nil {
+			t.Fatalf("expected invalid config to fail: %+v", config)
+		}
+	}
+}
