+package wireguard
+
+import (
+    "testing"
+    "google.golang.org/protobuf/proto"
+)
+
+func TestAmneziaRemoteDNSRoundTrip(t *testing.T) {
+    want := &DeviceConfig{DNS: []string{"1.1.1.1", "2606:4700:4700::1111"}, AmneziaConfig: "jc=4\ni1=<b 0x0102>\n"}
+    payload, err := proto.Marshal(want)
+    if err != nil { t.Fatal(err) }
+    got := new(DeviceConfig)
+    if err := proto.Unmarshal(payload, got); err != nil { t.Fatal(err) }
+    if !proto.Equal(want, got) { t.Fatalf("AWG and remote DNS did not survive together: %v", got) }
+}
